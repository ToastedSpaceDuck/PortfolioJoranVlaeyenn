---
const { title } = Astro.props;
---

<section class="projects">
  <h2>{title}</h2>
  <div class="projects-inner">
    <slot />
  </div>
</section>

<style>
  .projects {
    padding: 80px 120px;
    max-width: 1400px;
    margin: 0 auto;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .projects h2 {
    font-family: 'Space Mono', monospace;
    font-size: 32px;
    letter-spacing: -0.5px;
    margin-bottom: 40px;
  }

  .projects-inner {
    display: flex;
    flex-wrap: wrap;
    flex-direction: row;
    gap: 50px;
    width: 100%;
  }

  .projects-inner > :global(*) {
    flex: 1 1 300px;
    min-width: 0;
  }

  @media (max-width: 1024px) {
    .projects {
      padding: 60px 48px;
    }
  }

  @media (max-width: 768px) {
    .projects {
      padding: 48px 24px;
    }

    .projects h2 {
      font-size: 22px;
      margin-bottom: 28px;
    }

    .projects-inner {
      flex-direction: column;
      gap: 24px;
    }

    .projects-inner > :global(*) {
      flex: 1 1 100%;
    }
  }
</style>
