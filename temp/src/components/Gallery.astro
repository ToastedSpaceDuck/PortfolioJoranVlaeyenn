---
---
    <!-- ── GALLERY ── -->
    <section class="case-gallery">
      <div class="gallery-header">
        <span class="gallery-label">Project gallery</span>
        <h2>Selected visuals</h2>
      </div>

      <div class="gallery-grid">

        <div class="gallery-item">
          <img src="Images/MockupWebshopDesktop.png" alt="" data-title="Homepage redesign"
            data-description="This redesign focused on improving visual hierarchy, creating more consistency between sections, and introducing reusable UI components for scalability.">
        </div>

        <div class="gallery-item">
          <img src="Images/MockupWebshopMobile.png" alt="" data-title="Mobile redesign"
            data-description="I designed responsive mobile layouts to ensure a consistent experience across devices, with a focus on optimizing the checkout flow for smaller screens.">
        </div>

        <div class="gallery-item">
          <img src="Images/Colors.png" alt="" data-title="Color palette"
            data-description="A cohesive color palette was established, with a primary pink (#FF3655) and complementary neutrals to create a consistent visual identity.">
        </div>

        <div class="gallery-item">
          <img src="Images/Buttons.png" alt="" data-title="Inside the UI kit"
            data-description="The UI kit includes standardized components such as buttons, forms, and cards, all designed with a consistent style and coded for easy reuse across the online store.">
        </div>

        <div class="gallery-item">
          <img src="Images/Screenshot 2026-05-26 193347.png" alt="" data-title="Documentation of the UI kit"
            data-description="I created detailed documentation for the UI kit, including guidelines for typography, color usage, and component implementation to ensure consistency in future development.">
        </div>

      </div>
    </section>

    <!-- LIGHTBOX -->
    <div class="lightbox" id="lightbox">

      <div class="lightbox-content">

        <img class="lightbox-img" id="lightbox-img" src="" alt="">

        <div class="lightbox-info">
          <span class="lightbox-small">Case study detail</span>
          <h3 id="lightbox-title"></h3>
          <p id="lightbox-description"></p>
        </div>

      </div>

      <span class="lightbox-close">&times;</span>
    </div>