---
interface ExpectItem {
  title: string;
  description: string;
}

interface Tab {
  label: string;
  items: ExpectItem[];
}

interface Props {
  title: string;
  tabs: Tab[];
}

const { title, tabs } = Astro.props;
---

<section class="tab-section">
  <h2>{title}</h2>

  <div class="tab-bar">
    {tabs.map((tab, i) => (
      <button
        class="tab-btn"
        class:list={{ active: i === 0 }}
        data-tab-index={i}
      >
        {tab.label}
      </button>
    ))}
  </div>

  <div class="tab-panels">
    {tabs.map((tab, i) => (
      <div class="tab-panel" class:list={{ active: i === 0 }} data-tab-panel={i}>
        <div class="tab-panel__grid">
          {tab.items.map((item) => (
            <div class="tab-item">
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<script>
  document.querySelectorAll('.tab-section').forEach((section) => {
    const buttons = section.querySelectorAll('.tab-btn');
    const panels = section.querySelectorAll('.tab-panel');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const index = btn.getAttribute('data-tab-index');

        buttons.forEach((b) => b.classList.remove('active'));
        panels.forEach((p) => p.classList.remove('active'));

        btn.classList.add('active');
        section
          .querySelector(`[data-tab-panel="${index}"]`)
          ?.classList.add('active');
      });
    });
  });
</script>

<style>
  .tab-section {
    padding: 80px 120px;
    max-width: 1400px;
    margin: 0 auto;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .tab-section h2 {
    font-family: 'Space Mono', monospace;
    font-size: 32px;
    letter-spacing: -0.5px;
    margin-bottom: 32px;
    color: white;
  }

  .tab-bar {
    display: flex;
    gap: 8px;
    margin-bottom: 40px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .tab-btn {
    background: transparent;
    border: none;
    font-family: 'Space Mono', monospace;
    font-size: 14px;
    color: #8A8F98;
    padding: 14px 4px;
    margin-right: 28px;
    cursor: pointer;
    position: relative;
    transition: color 0.25s ease;
  }

  .tab-btn::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    background: #375ECC;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s ease;
  }

  .tab-btn:hover {
    color: #EDF4FA;
  }

  .tab-btn.active {
    color: white;
  }

  .tab-btn.active::after {
    transform: scaleX(1);
  }

  .tab-panel {
    display: none;
  }

  .tab-panel.active {
    display: block;
    animation: fadeIn 0.3s ease;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(6px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .tab-panel__grid {
    display: flex;
    flex-wrap: wrap;
    flex-direction: row;
    gap: 50px;
    width: 100%;
  }

  .tab-item {
    flex: 1 1 300px;
    min-width: 0;
    background: #13161E;
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 24px;
  }

  .tab-item h3 {
    font-family: 'Space Mono', monospace;
    font-size: 16px;
    font-weight: 700;
    margin-bottom: 14px;
    color: white;
  }

  .tab-item p {
    font-size: 15px;
    line-height: 1.75;
    color: #EDF4FA;
  }

  @media (max-width: 1024px) {
    .tab-section {
      padding: 60px 48px;
    }
  }

  @media (max-width: 768px) {
    .tab-section {
      padding: 48px 24px;
    }

    .tab-section h2 {
      font-size: 22px;
      margin-bottom: 24px;
    }

    .tab-bar {
      gap: 0;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }

    .tab-bar::-webkit-scrollbar {
      display: none;
    }

    .tab-btn {
      font-size: 12px;
      padding: 12px 2px;
      margin-right: 20px;
      white-space: nowrap;
      flex-shrink: 0;
    }

    .tab-panel__grid {
      flex-direction: column;
      gap: 16px;
    }

    .tab-item {
      flex: 1 1 100%;
      padding: 20px;
    }

    .tab-item h3 {
      font-size: 15px;
      margin-bottom: 10px;
    }

    .tab-item p {
      font-size: 14px;
    }
  }
</style>
