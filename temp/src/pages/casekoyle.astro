---
import BaseLayout from "../layouts/BaseLayout.astro";
import CaseHero from "../components/CaseHero.astro";
import GalleryItem from "../components/GalleryItem.astro";
---

<BaseLayout title="Case Study" activePage="casestudy">
    <CaseHero
        title="Project Koyle: Redesigning a cover band website for modern look and feel"
        CaseType="Project"
        CaseNumber="01"
        CaseTag1="UX Research"
        CaseTag2="UI Design"
        CaseTag3="Wireframing"
        CaseSubTag1="2026"
        CaseSubTag2="Unofficial project"
        CaseSubTag3="Koyle"
    />
    <main class="cs-main">
        <section class="cs-section">
            <div class="cs-section__num">1.</div>
            <div class="cs-section__body">
                <h2 class="cs-section__title">Summary</h2>
                <div class="summary-layout">
                    <p>
                        In this project, I redesigned the website for the cover
                        band Koyle in two weeks. My role was UX/UI designer,
                        with the goal of creating a modern, user-friendly site
                        that better reflects the band's style and is easy to
                        maintain. The old site was outdated, causing both fans
                        and potential bookers to lose interest. I began by
                        analyzing the current site. I then designed several
                        concept sketches and two versions of wireframes. After
                        user testing with five participants and making
                        adjustments, I created a final design for desktop and
                        mobile. The result is a fresh, visually striking website
                        with clear calls to action for booking the band.
                    </p>
                    <div class="mockup-slot">
                        <img
                            src="/public/MockupKoyle.png"
                            alt="Koyle website mockup"
                        />
                    </div>
                </div>
            </div>
        </section>

        <section class="cs-section">
            <div class="cs-section__num">2.</div>
            <div class="cs-section__body">
                <h2 class="cs-section__title">Timeline &amp; activities</h2>

                <div class="week-label">Week 1</div>
                <div class="timeline">
                    <div class="timeline__track">
                        <div
                            class="timeline__phase tl--research"
                            style="grid-column: 1 / 3;"
                        >
                            <span class="tl__label">Research</span>
                            <span class="tl__desc"
                                >Initial analysis &amp; initial concept sketches</span
                            >
                        </div>
                        <div
                            class="timeline__phase tl--design"
                            style="grid-column: 3 / 6;"
                        >
                            <span class="tl__label">Wireframing</span>
                            <span class="tl__desc"
                                >Wireframe designs V1 &amp; V2</span
                            >
                        </div>
                        <div
                            class="timeline__phase tl--impl"
                            style="grid-column: 5 / 7;"
                        >
                            <span class="tl__label">Design</span>
                            <span class="tl__desc">Adding colors and fonts</span
                            >
                        </div>
                    </div>
                    <div class="timeline__weeks">
                        <span>Mon</span><span>Tue</span><span>Wed</span><span
                            >Thu</span
                        ><span>Fri</span><span>Sat</span>
                    </div>
                </div>

                <div class="week-label" style="margin-top: 32px;">Week 2</div>
                <div class="timeline">
                    <div class="timeline__track">
                        <div
                            class="timeline__phase tl--impl"
                            style="grid-column: 1 / 3;"
                        >
                            <span class="tl__label">Design</span>
                            <span class="tl__desc">Adding colors and fonts</span
                            >
                        </div>
                        <div
                            class="timeline__phase tl--test"
                            style="grid-column: 2 / 4;"
                        >
                            <span class="tl__label">User testing</span>
                            <span class="tl__desc"
                                >Conduct user testing and record feedback</span
                            >
                        </div>
                        <div
                            class="timeline__phase tl--research"
                            style="grid-column: 4 / 6;"
                        >
                            <span class="tl__label">Final design</span>
                            <span class="tl__desc"
                                >Incorporating feedback into the design</span
                            >
                        </div>
                    </div>
                    <div class="timeline__weeks">
                        <span>Mon</span><span>Tue</span><span>Wed</span><span
                            >Thu</span
                        ><span>Fri</span><span>Sat</span>
                    </div>
                </div>
            </div>
        </section>

        <section class="cs-section">
            <div class="cs-section__num">3.</div>
            <div class="cs-section__body">
                <h2 class="cs-section__title">Problems and Objectives</h2>

                <h3 class="sub-title">3.1 Problems</h3>
                <div
                    class="three-grid"
                    style="grid-template-columns: repeat(2, 1fr);"
                >
                    <div class="info-card">
                        <h3>Visually outdated</h3>
                        <p>
                            An outdated website often creates a poor first
                            impression and undermines user trust.
                        </p>
                    </div>
                    <div class="info-card">
                        <h3>Outdated information</h3>
                        <p>
                            Outdated information causes confusion and undermines
                            user trust.
                        </p>
                    </div>
                </div>

                <h3 class="sub-title">3.2 Objectives</h3>
                <p>
                    Based on these challenges, I realized that the goal of this
                    project was to design a clear and appealing website that:
                </p>
                <div class="three-grid">
                    <div class="info-card">
                        <p>Showcases the band's identity.</p>
                    </div>
                    <div class="info-card">
                        <p>
                            Presents important information in a clear and
                            organized manner.
                        </p>
                    </div>
                    <div class="info-card">
                        <p>Makes the booking process as simple as possible.</p>
                    </div>
                </div>
            </div>
        </section>

        <section class="cs-section cs-section--card">
            <div class="cs-section__num">4.</div>
            <div class="cs-section__body">
                <h2 class="cs-section__title">Key insights</h2>
                <div class="three-grid">
                    <div class="insight-card">
                        <h3>Unclear call to action</h3>
                        <p>
                            The "Book Us" button was unclear and not prominent
                            enough. Users didn't immediately see how they could
                            book the band.
                        </p>
                    </div>
                    <div class="insight-card">
                        <h3>Outdated content</h3>
                        <p>
                            Many pages contained old tour dates and lyrics. This
                            made it difficult to find up-to-date information.
                        </p>
                    </div>
                    <div class="insight-card">
                        <h3>Poor mobile experience</h3>
                        <p>
                            The old site was not optimized for mobile devices.
                            Elements did not align properly, and important
                            buttons were displayed too small.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <section class="cs-section">
            <div class="cs-section__num">5.</div>
            <div class="cs-section__body">
                <h2 class="cs-section__title">Before &amp; after</h2>
                <div class="table-wrap">
                    <table class="comp-table">
                        <thead>
                            <tr>
                                <th>Feature</th>
                                <th>Before</th>
                                <th>After redesign (with UI kit)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Design &amp; branding</td>
                                <td
                                    >Outdated layout, no consistent brand
                                    identity</td
                                >
                                <td
                                    >Modern magazine-style design (photos,
                                    colors)</td
                                >
                            </tr>
                            <tr>
                                <td>Navigation</td>
                                <td>Confusing menus, poor structure</td>
                                <td
                                    >Intuitive navigation with prominent buttons</td
                                >
                            </tr>
                            <tr>
                                <td>Events</td>
                                <td>Past events on a News page, no calendar</td>
                                <td
                                    >Current calendar with date filter, events
                                    via CMS</td
                                >
                            </tr>
                            <tr>
                                <td>Call-to-action</td>
                                <td>No clear "Book Now" button</td>
                                <td
                                    >A clear "Book Now" CTA visible on every
                                    page</td
                                >
                            </tr>
                            <tr>
                                <td>Responsiveness</td>
                                <td>Not mobile-friendly</td>
                                <td
                                    >Fully responsive design for all screen
                                    sizes</td
                                >
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <section class="cs-section cs-section--card">
            <div class="cs-section__num">6.</div>
            <div class="cs-section__body">
                <h2 class="cs-section__title">Results</h2>
                <p>
                    The design now provides Koyle with a modern, functional
                    website and a proposed implementation plan. It is
                    recommended that this concept be implemented as a WordPress
                    website. WordPress is the most widely used CMS worldwide and
                    enables the band to manage events and content without any
                    technical knowledge.
                </p>
            </div>
        </section>
    </main>
</BaseLayout>

<style>
    .cs-main {
  max-width: 1400px;
  margin: 0 auto;
  padding: 0 80px;
}

.cs-section {
  display: grid;
  grid-template-columns: 60px 1fr;
  gap: 0 40px;
  padding: 72px 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.cs-section--card {
  background: #1F2228;
  padding: 48px;
  grid-template-columns: 60px 1fr;
  margin: 0 -48px;
  border-bottom: none;
  margin-bottom: -1px;
}

.cs-section__num {
  font-family: 'Space Mono', monospace;
  font-size: 12px;
  color: #8A8F98;
  padding-top: 6px;
  letter-spacing: 0.06em;
}

.cs-section__body {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.cs-section__title {
  font-family: 'Space Mono', monospace;
  font-size: clamp(20px, 2.5vw, 32px);
  line-height: 1.2;
  letter-spacing: -0.5px;
  margin-bottom: 4px;
}

.cs-section__body p {
  font-size: 15px;
  line-height: 1.75;
  color: #B8B8B8;
  max-width: 100%;
}

.sub-title {
  font-family: 'Space Mono', monospace;
  font-size: 16px;
  letter-spacing: -0.3px;
  color: white;
  margin-top: 12px;
}

.three-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
  margin-top: 8px;
}

.info-card {
  background: #13161E;
  border: 1px solid rgba(255, 255, 255, 0.08);
  padding: 24px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.info-card__icon {
  font-size: 22px;
  opacity: 0.5;
}

.info-card h3 {
  font-family: 'Space Mono', monospace;
  font-size: 14px;
  color: white;
  letter-spacing: 0.02em;
}

.info-card p {
  font-size: 14px !important;
  color: #8A8F98 !important;
  line-height: 1.6 !important;
}

.insight-card {
  background: #13161E;
  border: 1px solid rgba(55, 94, 204, 0.3);
  padding: 24px;
}

.insight-card p {
  font-size: 14px !important;
  color: #B8B8B8 !important;
  line-height: 1.65 !important;
}

.ideas {
  margin-top: 16px;
}

.idea-card {
  background: #13161E;
  border: 1px solid rgba(255, 255, 255, 0.08);
  padding: 24px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  transition: border-color 0.3s ease;
}

.idea-card:hover {
  border-color: rgba(255, 255, 255, 0.2);
}

.idea-card--chosen {
  background: #375ECC;
  border-color: #375ECC;
}

.idea-card__num {
  font-family: 'Space Mono', monospace;
  font-size: 11px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #8A8F98;
}

.idea-card--chosen .idea-card__num {
  color: rgba(255, 255, 255, 0.7);
}

.idea-card h3 {
  font-family: 'Space Mono', monospace;
  font-size: 14px;
  color: white;
}

.idea-card p {
  font-size: 14px;
  color: #8A8F98;
  line-height: 1.6;
}

.idea-card--chosen p {
  color: rgba(255, 255, 255, 0.8);
}

.conclusion-note {
  background: #13161E;
  border-left: 3px solid #375ECC;
  padding: 16px 20px;
  font-size: 14px !important;
  color: #B8B8B8 !important;
  line-height: 1.7 !important;
  max-width: 100% !important;
}

.objectives {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.objectives li {
  font-size: 15px;
  color: #B8B8B8;
  line-height: 1.65;
  padding-left: 20px;
  position: relative;
}

.objectives li::before {
  content: '→';
  position: absolute;
  left: 0;
  color: #375ECC;
}

.objectives strong {
  color: white;
}

.table-wrap {
  overflow-x: auto;
  border: 1px solid rgba(255, 255, 255, 0.08);
}

.comp-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 14px;
}

.comp-table th {
  background: #13161E;
  font-family: 'Space Mono', monospace;
  font-size: 11px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  text-align: left;
  padding: 14px 18px;
  color: #8A8F98;
  font-weight: 400;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.comp-table th:last-child {
  color: #375ECC;
}

.comp-table td {
  padding: 14px 18px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  vertical-align: top;
  color: #B8B8B8;
  line-height: 1.5;
}

.comp-table tr:last-child td {
  border-bottom: none;
}

.comp-table tbody tr:hover td {
  background: rgba(255, 255, 255, 0.02);
}

.comp-table td:first-child {
  font-family: 'Space Mono', monospace;
  font-size: 12px;
  color: #8A8F98;
  letter-spacing: 0.04em;
  white-space: nowrap;
}

.comp-table td:last-child {
  color: white;
}

.lessons {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.lessons li {
  font-size: 15px;
  color: #B8B8B8;
  line-height: 1.65;
  padding-left: 20px;
  position: relative;
}

.lessons li::before {
  content: '→';
  position: absolute;
  left: 0;
  color: #375ECC;
}

.week-label {
  font-family: 'Space Mono', monospace;
  font-size: 13px;
  color: #8A8F98;
  letter-spacing: 0.06em;
  margin-bottom: 10px;
}

.timeline {
  margin-top: 8px;
}

.timeline__track {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 6px;
  margin-bottom: 10px;
}

.timeline__phase {
  padding: 14px 16px;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.tl__label {
  font-family: 'Space Mono', monospace;
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: white;
}

.tl__desc {
  font-size: 12px;
  line-height: 1.45;
  color: #B8B8B8;
}

.tl--research { background: #1a2340; }
.tl--design   { background: #1F2228; }
.tl--impl     { background: #1a2340; }
.tl--test     { background: #1F2228; }

.timeline__weeks {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  border-top: 1px solid rgba(255, 255, 255, 0.08);
  padding-top: 8px;
}

.timeline__weeks span {
  font-family: 'Space Mono', monospace;
  font-size: 11px;
  color: #8A8F98;
  letter-spacing: 0.06em;
  text-align: center;
}

.timeline__weeks span:first-child { text-align: left; }
.timeline__weeks span:last-child  { text-align: right; }

.summary-layout {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 40px;
  align-items: center;
}

.mockup-slot {
  overflow: hidden;
  height: 320px;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.mockup-slot img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  object-position: bottom center;
}

@media (max-width: 1024px) {
  .cs-main {
    padding-left: 32px;
    padding-right: 32px;
  }

  .cs-section--card {
    margin: 0 -24px;
    padding: 36px 24px;
  }

  .three-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 768px) {
  .cs-main {
    padding: 0 24px;
  }

  .cs-section {
    grid-template-columns: 1fr;
    gap: 12px;
    padding: 48px 0;
  }

  .cs-section--card {
    margin: 0;
    padding: 32px 24px;
  }

  .summary-layout {
    grid-template-columns: 1fr;
  }

  .timeline__track {
    display: flex;
    flex-direction: column;
  }

  .timeline__weeks {
    display: none;
  }

  .three-grid {
    grid-template-columns: 1fr;
  }
}
</style>
